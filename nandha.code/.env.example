# Database configuration for MySQL (to view in MySQL Workbench)
# Replace 'YOUR_MYSQL_PASSWORD' with your actual MySQL root password:
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/referrals_db

# Email / SMTP Settings (Optional, needed when sending emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourmail@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=yourmail@gmail.com

# Matching threshold
MATCH_THRESHOLD=40

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jobnex-an-algonex-product",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "jobnex.dpdns.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "29523482392-lfhea4ot72omctqbcvq4e9qfrbp692ju.apps.googleusercontent.com",
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID": "29523482392-lfhea4ot72omctqbcvq4e9qfrbp692ju.apps.googleusercontent.com",
    "VITE_GOOGLE_CLIENT_ID": "29523482392-lfhea4ot72omctqbcvq4e9qfrbp692ju.apps.googleusercontent.com",
    "VITE_SUPABASE_URL": "https://swqebafkntjlgjglylcr.supabase.co",
    "VITE_SUPABASE_ANON_KEY": "sb_publishable_ax9iQjGlK5pP34biLoMcag_0egUp2qE"
  },
  "build": {
    "command": "pnpm run build"
  },
  "main": "Frontend/.output/server/index.mjs",
  "assets": {
    "directory": "Frontend/.output/public",
    "binding": "ASSETS"
  }
}

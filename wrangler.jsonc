{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jobnex-an-algonex-product",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "pnpm run build"
  },
  "main": "Frontend/.output/server/index.mjs",
  "assets": {
    "directory": "Frontend/.output/public",
    "binding": "ASSETS"
  }
}

{
  "name": "jobnex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter tanstack_start_ts run dev",
    "build": "pnpm --filter tanstack_start_ts run build",
    "lint": "pnpm --filter tanstack_start_ts run lint",
    "typecheck": "pnpm --filter tanstack_start_ts exec tsc --noEmit",
    "start": "python run.py",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/server": "^0.1.0",
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "prisma": "^6.4.1"
  }
}

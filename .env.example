# =============================================================
# Automatic Job Referral Email — Environment Variables
# Copy this file to .env and fill in your actual values
# =============================================================

# ---- Database ------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/job_referral_db

# ---- JWT Authentication --------------------------------------
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Google Gemini API (AI email generation) -----------------
GEMINI_API_KEY=your-gemini-api-key-here

# ---- Gmail OAuth 2.0 -----------------------------------------
# Create credentials at https://console.cloud.google.com/
# Download the credentials JSON and paste the values below
GMAIL_CLIENT_ID=your-gmail-oauth-client-id
GMAIL_CLIENT_SECRET=your-gmail-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# ---- App Settings -------------------------------------------
APP_NAME=Job Referral Email Assistant
APP_VERSION=1.0.0
DEBUG=true
FRONTEND_URL=http://localhost:8000
